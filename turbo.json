{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_ACORN_API_URL", "VITE_ACORN_WEB_URL", "ACORN_API_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    }
  }
}
