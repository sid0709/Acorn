{
  "name": "acorn-extension",
  "version": "2.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "format:check": "prettier --check src",
    "test": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@acorn/app-theme": "workspace:*",
    "@acorn/face": "workspace:*",
    "@acorn/shared": "workspace:*",
    "@acorn/support-chat": "workspace:*",
    "@astryxdesign/core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sid-ui": "catalog:",
    "socket.io-client": "catalog:"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "catalog:",
    "@types/chrome": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
