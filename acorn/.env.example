# Acorn's extension talks to acorn-backend at api.acornapply.com in production
# builds, and the local API in development builds. Copy this file to acorn/.env to
# override either at build time. Rebuild and reload the extension after a change.
# Deploy runs tools/extension-release.mjs with these VITE_* keys (or CI vars) before zipping.
# Only VITE_* keys are bundled; anything else in this file stays out of the build.
# VITE_ACORN_API_URL=https://api.acornapply.com
# VITE_ACORN_WEB_URL=https://acornapply.com

# Local acorn-agent (bun run dev:acorn-agent). Development default is 8093 if unset.
# VITE_ACORN_AGENT_URL=http://127.0.0.1:8093

# Local debug capture, development builds only (bun run dev:acorn); a production
# build (bun run build:acorn) ignores it. "true" makes Fill attach the page HTML, DOM tree, and planner
# trees to Analyze and stream step traces to the backend. Pair with ACORN_DEBUG_DIR in
# acorn-backend/.env; each Fill gets a run folder there. Never set for a release build.
# VITE_ACORN_DEBUG=true

# Auto-Focus (sidebar switch): while Run works in several tabs, each run tab is brought
# to the front in turn for this many seconds. A missing or invalid value means 2.
# VITE_ACORN_AUTO_FOCUS_SECONDS=2
