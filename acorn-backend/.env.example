# acorn-backend: Acorn's API. Routes live under /acorn. nginx publishes it at api.acornapply.com.

# MongoDB server. Acorn's data lives in ACORN_DB.
MONGO_URI=
# ACORN_DB=AcornDB

# AI calls use the OpenRouter key saved on the account profile. No server AI key.

# Where the server listens and which browser origins may call it.
# HTTP_ADDR=127.0.0.1:8083
# CORS_ORIGINS=http://localhost:6005,http://127.0.0.1:6005

# Sign in with Google. Register this redirect on the OAuth client:
#   http://localhost:6005/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_SIGNIN_REDIRECT_URL=http://localhost:6005/auth/google/callback
# Gmail mailbox OAuth (separate from sign-in). Optional when GOOGLE_SIGNIN_REDIRECT_URL
# ends with /auth/google/callback — then Gmail uses /auth/gmail/callback on the same host.
# Register that URI on the same OAuth client in Google Cloud and enable the Gmail API.
# GOOGLE_GMAIL_REDIRECT_URL=http://localhost:6005/auth/gmail/callback

# Arriving Gmail is labelled oak-verify-email when it delivers a verification code or link
# (see mailwatch/README.md). Each judged email is one Jev call on the account's OpenRouter key.
# Without GMAIL_PUSH_TOPIC the server polls each mailbox's Gmail history (2 quota units a call).
# MAIL_VERIFY_POLL_INTERVAL=30s
# Label only when Jev is at least this sure (0 to 1).
# MAIL_VERIFY_MIN_CONFIDENCE=0.8
# Real-time push instead (needs a Google Cloud project with billing for Pub/Sub). All three together:
# GMAIL_PUSH_TOPIC=projects/<project-id>/topics/<topic>
# GMAIL_PUSH_AUDIENCE=https://api.example.com/acorn/gmail/push
# GMAIL_PUSH_SERVICE_ACCOUNT=<name>@<project-id>.iam.gserviceaccount.com

# Name of the cookie acorn-frontend keeps the Acorn session token in.
# ACORN_SESSION_COOKIE=acorn_session

# Local debug capture. Each Fill's Analyze gets a folder here with the page HTML, DOM
# and planner trees, applicant profile, every AI prompt and answer, the plan, and the
# extension's step trace (build the extension with VITE_ACORN_DEBUG=true in acorn/.env).
# Writes personal data to disk: local runs only, never production.
# ACORN_DEBUG_DIR=./debug-runs

# Runtime kill switches. Unset leaves the feature on. off/false/0/no/disabled turns it off.
# KILLSWITCH_ACORN_AI=on
# KILLSWITCH_CACHE_MS=5000

# Support console (acorn-admin on port 6010) signs in through /acorn/admin/* on this API.
# Admin sign-in accepts any non-empty username/email (password ignored). Production: set ACORN_ADMIN_SESSION_SECRET.
# ACORN_ADMIN_DEMO=on
# ACORN_ADMIN_SESSION_SECRET=change-me
# ACORN_ADMIN_EMAIL=
# ACORN_ADMIN_PASSWORD=

# acorn-frontend's origin. Admin "Sign in as user" links land on <ACORN_WEB_URL>/auth/support.
# Unset uses production (https://acornapply.com); set this locally to your site.
# ACORN_WEB_URL=http://localhost:6005

# Résumé files and profiles are kept in memory until a write through this server changes them,
# and every account's files are read into memory when the server starts (the recently signed-in first).
# ACORN_LIBRARY_CACHE_MB caps the files kept (default 8192). ACORN_LIBRARY_PRELOAD=off skips the
# start-up read, as a development server on a distant database may want. ACORN_CACHE_TRUST_SECONDS
# makes a copy be read again after that long, for a deployment where another process can write.
# ACORN_LIBRARY_CACHE_MB=8192
# ACORN_LIBRARY_PRELOAD=on
# ACORN_CACHE_TRUST_SECONDS=

# The terminal shows ordinary news as short sentences. Set to debug to see the quiet lines too (the
# extension's socket reconnecting, health checks, model calls nobody records).
# ACORN_LOG_LEVEL=debug
