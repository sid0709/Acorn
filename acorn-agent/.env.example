# acorn-agent: copy to .env and fill in. Nothing here is committed.

# The OpenRouter key the agent calls the model and the decision model with.
OPENROUTER_API_KEY=

# Read the applicant from the signed-in person's own account instead of local files: the address of
# acorn-backend. The extension sends the person's Acorn session with each run, so they must be signed in.
# Unset, the applicant is profile.json and resumes/ below. Locally: http://127.0.0.1:8083
# ACORN_AGENT_BACKEND_URL=

# Where the applicant's profile.json and resumes/ live (default: ./data); used only without the backend.
# ACORN_AGENT_DATA_DIR=data

# Each run's screenshots and answers are recorded here (default: ./traces). Set to false to stop recording.
# ACORN_AGENT_TRACE=false
# ACORN_AGENT_TRACE_DIR=traces

# The terminal tells each run as short sentences. Set to debug to see the quiet lines too (every request
# the extension makes).
# ACORN_AGENT_LOG_LEVEL=debug

# The model that drives a run, and the reasoning effort sent with each step.
# ACORN_AGENT_MODEL=openai/gpt-6-luna
# ACORN_AGENT_REASONING=none

# The decision model that checks the screen between the runs of a plan (set ACORN_AGENT_CHECKS=false
# to turn the checks off), how many actions run between checks, and how sure it must be (percent).
# ACORN_AGENT_CHECKS=true
# ACORN_AGENT_SCREEN_MODEL=openai/gpt-6-luna-decisions
# ACORN_AGENT_CHUNK_ACTIONS=6
# ACORN_AGENT_CHECK_MATCH_PERCENT=90
# ACORN_AGENT_CHECK_BLOCKED_PERCENT=20
# ACORN_AGENT_CHECK_LOADING_PERCENT=30
# How sure (percent) it must be which option of an open dropdown answers a "choose" action.
# ACORN_AGENT_OPTION_MATCH_PERCENT=70

# How sure (percent) the decision model must be that a control, window or frame is an online file
# source for the agent to refuse it. Files only ever come from this computer.
# ACORN_AGENT_VET_BLOCK_PERCENT=30

# How sure (percent) the decision model must be that a control, window or frame signs in through
# another service's account (single sign-on) for the agent to refuse it.
# ACORN_AGENT_SSO_BLOCK_PERCENT=50
# How many steps may type the account password (sign-in, sign-up, password reset) before the run
# ends because the site rejects the account.
# ACORN_AGENT_ACCOUNT_ATTEMPTS=8

# Bounds on one run (30 actions with checks, 6 without).
# ACORN_AGENT_MAX_STEPS=150
# How many times a stop for the applicant is sent back to finish the whole page first (0 accepts it at once).
# ACORN_AGENT_STOP_PASSES=2
# "Done" needs the page to show the application was sent: how many times a done the screen does not
# confirm is sent back, and how sure (percent) the checker must be (a negative count accepts every done).
# ACORN_AGENT_DONE_PASSES=2
# ACORN_AGENT_DONE_CONFIRM_PERCENT=70
# ACORN_AGENT_MAX_ACTIONS=30
# Fast fill: every run plans a whole page from one look and carries the plan out without stopping to look.
# "on" turns it on for every run; the extension follows the agent, so no rebuild is needed (the extension's
# own switch is VITE_ACORN_AGENT_FAST_FILL in acorn/.env). Unset or "off" goes step by step.
# ACORN_AGENT_FAST_FILL=on
# The most actions one plan may hold in a fast-fill run (a whole page at once).
# ACORN_AGENT_FAST_FILL_ACTIONS=60
# How many steps stay in full in the model's history, and how many earlier screenshots are sent again
# beside the current one (0: only the current screenshot goes, which keeps every request small).
# ACORN_AGENT_KEEP_TURNS=8
# ACORN_AGENT_KEEP_IMAGES=0
# ACORN_AGENT_MAX_STALE=6

# Development with local files only: the résumé folder (a name under data/resumes) offered to you
# when a résumé is wanted and no job description was found on the pages. It must exist, or a run will
# not start. With ACORN_AGENT_BACKEND_URL this is ignored: the default is the résumé each person
# marked "Make default" in their Library on the Acorn website.
# DEFAULT_FALLBACK_RESUME=AI - Full Stack

# Listen address (default 127.0.0.1:8093: this machine only).
# HTTP_ADDR=127.0.0.1:8093
# ACORN_AGENT_PORT=8093
