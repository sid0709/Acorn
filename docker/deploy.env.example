# Copy to /opt/acorn/deploy.env and chmod 600. Do not commit real secrets.
# The API container reads this file. The website container does not.

MONGO_URI=mongodb://host.docker.internal:27017/
ACORN_DB=AcornDB

# AI calls use the OpenRouter key saved on the account profile. No server AI key.

# Listen on every interface inside the container. nginx on the host publishes 127.0.0.1:8083.
HTTP_ADDR=0.0.0.0:8083
CORS_ORIGINS=https://acorn.remotepairnet.net

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SIGNIN_REDIRECT_URL=https://acorn.remotepairnet.net/auth/google/callback
