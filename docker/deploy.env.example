# Copy to /opt/acorn/deploy.env and chmod 600. Do not commit real secrets.
# The API container reads this file. The website container does not.

# MongoDB runs on this same host: the API container reaches it through the host
# gateway (deploy-remote.sh adds host.docker.internal), never through the public IP.
MONGO_URI=mongodb://host.docker.internal:27017/
ACORN_DB=AcornDB

# AI calls use the OpenRouter key saved on the account profile. No server AI key.

# Listen on every interface inside the container. nginx on the host publishes 127.0.0.1:8083.
HTTP_ADDR=0.0.0.0:8083
CORS_ORIGINS=https://acornapply.com,https://www.acornapply.com,https://admin.acornapply.com

# acorn-agent (the Run's planner) reads only the lines below that start with ACORN_AGENT_, plus
# OPENROUTER_API_KEY. It never sees the database or Google settings above.
# It reads each person's profile and Library from this API with that person's own session, so there is
# nothing to set for it to find them. Each person's OpenRouter key comes from their profile, and the
# résumé offered when a page shows no job description is the one they marked default in their Library.
# A person with an OpenAI API key in their profile has their runs driven on OpenAI directly (no request cap for a new
# OpenRouter account); the deploy sets this to true unless you set it to false here. The model and the per-token prices
# (ACORN_AGENT_OPENAI_MODEL, ACORN_AGENT_OPENAI_PRICE_INPUT / _CACHED / _CACHE_WRITE / _OUTPUT) can be set here too.
# ACORN_AGENT_OPENAI=true
# ACORN_AGENT_MAX_MODEL_CALLS=256
# Host port published for nginx /agent/v1/. Default 8093. Do not use 8083, 6005,
# 6011, 8080, 8081.
# ACORN_AGENT_PORT=8093

# The contact address the website's Privacy Policy and Terms pages show. Set it before the Chrome Web Store
# or Google OAuth review: they check that a policy names a way to reach you.
# ACORN_CONTACT_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SIGNIN_REDIRECT_URL=https://acornapply.com/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URL=https://acornapply.com/auth/gmail/callback

# Staff console (acorn-admin). CI can set these from GitHub Environment variables
# ACORN_ADMIN_USERNAME and ACORN_ADMIN_PWD (mapped to ACORN_ADMIN_EMAIL / ACORN_ADMIN_PASSWORD).
# ACORN_ADMIN_DEMO=off
# ACORN_ADMIN_SESSION_SECRET=change-me
# ACORN_WEB_URL=https://acornapply.com
