  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "migrate:jobs": "node scripts/migrate-jobs-athensai-to-athensdb.mjs",
    "migrate:temp-jobs": "node scripts/reshape-jobs-and-split-temp.mjs",
    "migrate:temp-ingest": "node scripts/align-temp-jobs-ingest-schema.mjs",
