    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "mongodb": "^7.5.0",
    "nodemailer": "^9.0.4",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
