generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Shared with Athens-server / Firestore sync shape. Collection: account_info.
model AccountInfo {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  name              String  @unique
  /// Lowercased login key. Not unique in Prisma — legacy rows may share null.
  usernameKey       String?
  password          String?
  tier              String?
  permission        String?
  /// Signup approval: "Pending" until an admin sets "Approved". Missing = legacy Approved.
  userStatus        String?
  vendorAllowed     Boolean?
  vendorPassword    String?
  autoBidProfile    Json?
  notificationPrefs Json?
  notionIntegration Json?
  /// Analyzed library skills by stack title: { [title]: [{ name, category, level }] }
  resumeAnalysisCatalog Json?
  /// ISO-8601 string (Athens-server contract — not BSON Date).
  resumeAnalysisCatalogUpdatedAt String?
  /// AI Mail labeling: { [labelPath: string]: description }
  mailAiLabelDefinitions Json?

  jobStatuses     JobStatus[]
  resumes         Resume[]
  resumeTemplates ResumeTemplate[]

  @@index([usernameKey])
  @@index([userStatus])
  @@map("account_info")
}

/// Per-source membership on a company (newest-first jobIds).
type CompanySourceBucket {
  source       String
  lastPostedAt DateTime
  count        Int
  jobIds       String[] @db.ObjectId
}

/// Employer identity for Job Search grouping. jobIds are catalog `jobs` ids, newest-first.
model Company {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Normalized companyName (trim + lowercase + collapse whitespace).
  companyKey   String   @unique
  companyName  String
  companyLogo  String?
  companyUrl   String?
  jobIds       String[] @db.ObjectId
  lastPostedAt DateTime
  /// Denormalized jobIds.length for cheap unfiltered counts.
  jobCount     Int
  sourceBuckets CompanySourceBucket[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lastPostedAt(sort: Desc)])
  @@index([sourceBuckets.source])
  @@map("companies")
}

/// Lean Job Search catalog (searchable). Incomplete title-review / skill-extract rows live in `temp_jobs`.
/// Filter/search fields are flat; capsules live in metadata.
model Job {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  companyName      String
  /// FK to companies._id (no Prisma relation — membership lives on Company.jobIds).
  companyId        String?  @db.ObjectId
  source           String
  postedAt         DateTime
  titleReviewLabel String
  sourceCatalog    String   @default("market")
  companyLink      String?
  applyLink        String?
  description      String?
  /// [{ name, category, requirement }]
  aiSkills         Json?
  aiSkillStatus    String?
  modelSchemaCode  String   @map("model_schema_code")
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// { legacyId?, companyLogo?, details?: { location?, time?, remote?, seniority?, salary? }, titleReview? }
  metadata         Json?

  statuses JobStatus[]

  /// Unfiltered Job Search: orderBy postedAt desc without a leading filter key.
  @@index([postedAt(sort: Desc)])
  @@index([titleReviewLabel, postedAt(sort: Desc)])
  @@index([titleReviewLabel, source, postedAt(sort: Desc)])
  @@index([sourceCatalog, titleReviewLabel, postedAt(sort: Desc)])
  @@index([createdBy, postedAt(sort: Desc)])
  @@index([companyId, postedAt(sort: Desc)])
  @@index([source, postedAt(sort: Desc)])
  @@index([source, companyId, postedAt(sort: Desc)])
  @@map("jobs")
}

/// Staging ingest shape (≠ Job). Scrapers land here after prenorm.
/// Title Review + Skill Extract filter this collection directly (queue state is on the row).
/// Promote into `jobs` via registerJob when titleReviewLabel=APPROVED and aiSkillStatus is done.
model TempJob {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  companyName      String
  companyId        String?  @db.ObjectId
  source           String
  postedAt         DateTime
  /// Raw relative posting text from scrapers (e.g. "2 days ago").
  postedAgo        String?
  titleReviewLabel String
  sourceCatalog    String   @default("market")
  companyLink      String?
  applyLink        String?
  description      String?
  /// [{ name, category, requirement }]
  aiSkills         Json?
  aiSkillStatus    String?
  modelSchemaCode  String   @map("model_schema_code")
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// { legacyId?, companyLogo?, details?, titleReview?, scrape? }
  metadata         Json?

  @@index([postedAt(sort: Desc)])
  @@index([titleReviewLabel, postedAt(sort: Desc)])
  @@index([titleReviewLabel, source, postedAt(sort: Desc)])
  @@index([aiSkillStatus, postedAt(sort: Desc)])
  @@index([createdBy, postedAt(sort: Desc)])
  @@index([companyId, postedAt(sort: Desc)])
  @@map("temp_jobs")
}

/// One row per profile × job. Status is owned by the profile, never shared.
model JobStatus {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId String   @db.ObjectId
  jobId     String   @db.ObjectId
  /// posted | bid-ready | worker-pool | bid-completed | applied | scheduled | declined
  state     String
  /// First transition to bid-ready — stable Bid Management folder day (never restamp).
  bidReadyAt     DateTime?
  bidCompletedAt DateTime?
  /// First transition to worker-pool — Oak queue order (never restamp).
  workerPoolAt   DateTime?
  /// Denormalized from Job.postedAt for Lens ordering.
  postedAt  DateTime?
  /// Library / customized resume chosen while Bid ready or Worker pool.
  /// Copied from vendor_tasks on apply so Job Search still shows it.
  recommendedResumeStack  String?
  recommendedResumeId     String?   @db.ObjectId
  recommendedResumeReason String?
  useCustomizedResume     Boolean?
  recommendWarning        String?
  recommendedAt           DateTime?
  /// llm | heuristic | manual
  recommendMode           String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account AccountInfo @relation(fields: [profileId], references: [id])
  job     Job         @relation(fields: [jobId], references: [id])

  @@unique([profileId, jobId])
  @@index([profileId, state])
  @@index([profileId, state, postedAt(sort: Desc)])
  @@index([jobId])
  @@map("job_statuses")
}

/// Bid Management + Athens Lens work item (one per applier × job).
/// Video bytes live in Firebase Storage; this row holds metadata only.
model VendorTask {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  applierName String
  jobId       String
  title       String  @default("Untitled role")
  company     String  @default("")
  applyUrl    String?
  source      String  @default("")
  location    String  @default("")
  workMode    String  @default("")
  matchScore  Float?

  /// pending | done | skipped
  status              String    @default("pending")
  /// submitted | reviewed | rejected
  reviewStatus        String?
  bidderInProcess     Boolean   @default(false)
  bidderInProcessAt   DateTime?
  bidderName          String?
  bidSessionId        String?
  addedAt             DateTime  @default(now())
  completedAt         DateTime?
  /// Stable folder day — copy from JobStatus.bidReadyAt; do not restamp.
  bidReadyDate        DateTime?
  biddingDurationSec  Float?

  /// Why the bidder skipped this job from Athens Lens.
  skipReason        String?
  rejectReason      String?
  /// submitted | skipped
  rejectSource      String?
  rejectCount       Int       @default(0)
  resubmitCount     Int       @default(0)
  lastRejectedAt    DateTime?
  lastResubmittedAt DateTime?

  recordingPath          String?
  recordingContentType   String?
  recordingSize          Int?
  recordingSha256        String?
  recordingGeneration    String?
  recordingDurationSec   Float?
  recordingStartedAt     DateTime?
  recordingEndedAt       DateTime?
  /// [{ storagePath, contentType, sizeBytes, sessionId, sha256, generation, durationSec, recordedStartAt, recordedEndAt, uploadedAt }]
  recordings             Json?

  recommendedResumeStack  String?
  /// Library Resume.id when user (or AI) picks a specific file; null for customized.
  recommendedResumeId     String?  @db.ObjectId
  recommendedResumeReason String?
  useCustomizedResume     Boolean  @default(false)
  recommendWarning        String?
  recommendedAt           DateTime?
  /// llm | heuristic | manual
  recommendMode           String?
  recommendUsage          Json?
  recommendRequestId      String?
  /// match | mismatch | unknown
  resumeStackMatch        String?

  resumeOriginalName String?
  resumeExpectedName String?
  resumeCleanedName  String?
  resumeRenamed      Boolean   @default(false)
  resumeMismatch     Boolean   @default(false)
  /// [{ originalName, expectedName, cleanedName, renamed, mismatch, sessionId, source, fileSize, mimeType, auditKey, recordedAt }]
  resumeAudits       Json?

  analysisSummary     String?
  analysisFormAnswers Json?
  /// llm | heuristic
  analysisMode        String?
  analysisPageUrl     String?
  analysisPageTitle   String?
  analysisUsage       Json?
  analysisRequestId   String?
  analyzedAt          DateTime?
  flagAnalysisMode    String?
  flagAnalysisUsage   Json?
  flagAnalysisRequestId String?
  flagAnalyzedAt      DateTime?
  flags               Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applierName, jobId])
  @@index([applierName, addedAt(sort: Desc)])
  @@index([applierName, reviewStatus, lastRejectedAt(sort: Desc)])
  @@map("vendor_tasks")
}

/// Timeline for Bid Management detail pane.
model BidReviewEvent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  applierName  String
  jobId        String
  vendorTaskId String?
  eventType    String
  /// Idempotency key (e.g. ai:requestId).
  eventKey     String?
  meta         Json?
  feature      String?
  createdAt    DateTime @default(now())

  @@unique([applierName, jobId, eventKey])
  @@index([applierName, jobId, createdAt(sort: Desc)])
  @@map("bid_review_events")
}

/// Athens Lens bearer sessions. Doc id = sha256(token) hex.
model AthensLensSession {
  id              String   @id @map("_id")
  accountId       String
  profileId       String
  applierName     String
  username        String
  authenticatedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
  @@map("athens_lens_sessions")
}

/// Oak extension / UI board bearer sessions. Doc id = sha256(token) hex.
model OakSession {
  id              String   @id @map("_id")
  accountId       String
  profileId       String
  applierName     String
  username        String
  authenticatedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
  @@map("oak_sessions")
}

/// Resumable bid-recording upload handshake (bytes in Firebase Storage).
model UploadSession {
  id             String    @id @map("_id")
  uid            String?
  applierName    String
  jobId          String
  sessionId      String
  storagePath    String
  contentType    String
  expectedBytes  Int
  expectedSha256 String?
  /// pending | completed | rejected
  status         String    @default("pending")
  expiresAt      DateTime
  actualBytes    Int?
  actualSha256   String?
  generation     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([applierName, jobId])
  @@index([expiresAt])
  @@map("upload_sessions")
}

/// Uploaded / generated resume library. Binary lives in Firebase Storage;
/// this row holds title (upload folder), file meta, and analysis object.
model Resume {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId     String    @db.ObjectId
  ownerName     String
  /// Upload folder / stack label (legacy API field: techStack)
  title         String
  fileName      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  contentSha256 String
  extractedText String?
  isPrimary     Boolean   @default(false)
  source        String    @default("uploaded")
  generationId  String?
  templateId    String?
  /// Job Search generated résumé — one library row per applier × job.
  parentJobId   String?
  analyzed      Boolean   @default(false)
  analyzedAt    DateTime?
  /// { skills: [{ name, category, level }], provider?, model?, usage? }
  analysis      Json?
  analysisError String?
  uploadedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account AccountInfo @relation(fields: [profileId], references: [id])

  @@index([profileId, uploadedAt(sort: Desc)])
  @@index([profileId, title])
  @@index([ownerName, uploadedAt(sort: Desc)])
  @@index([generationId])
  @@index([ownerName, parentJobId])
  @@map("resumes")
}

/// Uploaded Word resume templates with `{}` placeholders. Binary in Firebase Storage.
model ResumeTemplate {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId     String   @db.ObjectId
  ownerName     String
  name          String
  fileName      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  contentSha256 String
  slotCount     Int
  /// ("summary" | "skills" | "experience")[]
  sectionsFound Json
  /// Parsed `{}` placeholder slots
  slots         Json
  warnings      Json
  uploadedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account AccountInfo @relation(fields: [profileId], references: [id])

  @@index([profileId, uploadedAt(sort: Desc)])
  @@index([ownerName, uploadedAt(sort: Desc)])
  @@map("resume_templates")
}

/// Persistent Resume Generator settings (Profile-scoped). Collection: resume_generator_config.
model ResumeGeneratorConfig {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  applierName String
  profileId   String?
  /// Canonical v4 generator config JSON
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([applierName, updatedAt(sort: Desc)])
  @@index([profileId])
  @@map("resume_generator_config")
}

/// Completed / failed Resume Generator application runs. Collection: resume_generations.
model ResumeGeneration {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  applierName            String?
  provider               String?
  model                  String?
  status                 String
  backgroundTaskInputId  String?
  /// Snapshot of generator config used for this run
  config                 Json?
  identity               Json?
  jobDescription         String?
  coverageAnalysis       Json?
  coverageContract       Json?
  sections               Json?
  perStep                Json?
  usage                  Json?
  skillProfile           Json?
  techStack              String?
  skillAnalysisError     String?
  analyzed               Boolean   @default(false)
  analyzedAt             DateTime?
  isBeta                 Boolean   @default(false)
  dynamicCareerTitles    Boolean   @default(false)
  titlePolicyVersion     Int?
  titlePolicyFingerprint String?
  identitySyncedAt       String?
  identityRefreshedAt    DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([applierName, startedAt(sort: Desc)])
  @@index([backgroundTaskInputId])
  @@index([applierName, status])
  @@map("resume_generations")
}

/// Idempotent generation request payloads (sha256 hex id). Collection: background_task_inputs.
model BackgroundTaskInput {
  id              String    @id @map("_id")
  kind            String
  requestId       String?
  profileId       String?
  applierName     String?
  status          String
  request         Json?
  partialSections Json?
  progress        Json?
  result          Json?
  error           String?
  workerTaskId    String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?

  @@index([applierName, status])
  @@index([requestId])
  @@index([expiresAt])
  @@map("background_task_inputs")
}

/// Cached Gmail message (list = headers/snippet; body filled on open).
model MailMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  applierName String
  mailbox     String
  uid         Int
  messageId   String?
  fromName    String?
  fromEmail   String?
  toJson      Json?
  ccJson      Json?
  subject     String
  preview     String   @default("")
  bodyText    String?
  bodyHtml    String?
  date        DateTime
  seen        Boolean  @default(false)
  flagged     Boolean  @default(false)
  gmailLabels String[]
  folder      String   @default("inbox")
  labels      String[]
  hasBody     Boolean  @default(false)
  syncedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([applierName, mailbox, uid])
  @@index([applierName, folder, date(sort: Desc)])
  @@index([applierName, date(sort: Desc)])
  @@index([applierName, folder, labels])
  @@index([applierName, date(sort: Desc), labels])
  @@map("mail_messages")
}

/// Per-applier mail sync cursors + cached Gmail label list.
model MailSyncState {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  applierName      String    @unique
  highestUid       Int       @default(0)
  lowestUid        Int       @default(0)
  lastSyncAt       DateTime?
  syncing          Boolean   @default(false)
  gmailLabelsJson  Json?
  folderCountsJson Json?
  updatedAt        DateTime  @updatedAt

  @@map("mail_sync_state")
}

/// Background task queue (mail_ai_label and future types).
model BackgroundTask {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  requestId            String?
  type                 String
  status               String
  profileId            String?
  applierName          String?
  payload              Json?
  progress             Json?
  result               Json?
  error                String?
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  createdAt            DateTime  @default(now())
  startedAt            DateTime?
  cancelRequestedAt    DateTime?
  cancelAcknowledgedAt DateTime?
  finishedAt           DateTime?
  updatedAt            DateTime  @updatedAt
  eventSequence        Int       @default(0)

  @@index([requestId])
  @@index([profileId, status, updatedAt(sort: Desc)])
  @@index([status, leaseExpiresAt])
  @@index([type, status])
  @@map("background_tasks")
}

/// Idempotency reservations for background tasks.
model BackgroundTaskReservation {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  key       String    @unique
  taskId    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("background_task_reservations")
}

/// Compact current status snapshot for /status fallback (one doc per source).
model MonitorStatus {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  source             String   @unique
  version            Int      @default(2)
  updatedAt          DateTime @updatedAt
  /// ComponentStatus[]
  components         Json
  /// { [componentId]: incidentId }
  activeIncidentIds  Json?

  @@map("monitor_status")
}

/// Completed daily availability rollups.
model MonitorDay {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  date       String   @unique
  source     String
  version    Int      @default(2)
  complete   Boolean
  /// DailyComponentRollup[]
  components Json
  updatedAt  DateTime @updatedAt

  @@map("monitor_days")
}

/// Public status incidents (auto + manual).
model MonitorIncident {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  source         String
  component      String
  name           String
  status         String
  severity       String
  title          String
  description    String
  startedAt      DateTime
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  /// IncidentUpdate[]
  updates        Json
  manual         Boolean?
  internalReason String?

  @@index([startedAt(sort: Desc)])
  @@index([component, startedAt(sort: Desc)])
  @@map("monitor_incidents")
}

/// AI call usage log (replaces Firestore ai_api_usage written by ai-bff).
/// Field names match Athens UI / buildAiApiUsageEntry (local ai-usage/lib).
model AiApiUsage {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt         DateTime  @default(now())
  requestId         String
  feature           String?
  provider          String?
  requestedModel    String?
  billedModel       String?
  modelMismatch     Boolean?
  apiKey            String?
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  totalTokens       Int?
  costUsd           Float?
  priced            Boolean?
  rates             Json?
  startedAt         DateTime?
  durationMs        Int?
  success           Boolean?
  httpStatus        Int?
  error             String?
  runId             String?
  applierName       String?
  jobId             String?
  path              String?
  service           String?

  @@unique([requestId])
  @@index([createdAt(sort: Desc)])
  @@index([applierName, createdAt(sort: Desc)])
  @@index([feature, createdAt(sort: Desc)])
  @@index([runId])
  @@index([provider, billedModel, createdAt(sort: Desc)])
  @@map("ai_api_usage")
}

/// Global product config (singleton per `key`). Collection: athens_metadata.
/// `companyBlockRules`: admin-owned employer block list applied on job create.
model AthensMetadata {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  key               String   @unique
  /// [{ id, companyName, companyKey, createdAt, createdBy }]
  companyBlockRules Json
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("athens_metadata")
}

/// this is for extension
model Extension {
  id          String   @id @default(auto())  @map("_id") @db.ObjectId

  key         String
  name        String?
  version     String?
  label       String?
  description String?

  isActive    Boolean  @default(true)

  @@unique([key])
  @@map("extensions")
}
