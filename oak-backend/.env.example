# MongoDB — database name must be AthensDB (not AthensAI).
DATABASE_URL="mongodb://USER:PASSWORD@HOST:27017/AthensDB?authSource=admin"

PORT=8980
# Pino: debug locally, info in production. Pretty+color unless NODE_ENV=production.
# LOG_LEVEL=debug
# LOG_PRETTY=true
# Comma-separated browser origins. chrome-extension:// is always allowed (Athens Lens).
# Use * (or leave empty) to reflect any origin. A literal * list entry is not a wildcard.
CORS_ORIGIN=http://127.0.0.1:9030,http://localhost:9030,http://127.0.0.1:5173,http://localhost:5173

# 32-byte hex key for enc:v1 profile secrets (openssl rand -hex 32)
API_KEYS_ENCRYPTION_KEY=

# Firebase Admin SDK (Firebase Atlas explorer — Firestore + Storage).
# Copy values from Athens-server/.env (same Firebase project).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Absolute path recommended (Athens-server often uses secrets/ relative to that package).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
FIREBASE_AUTH_REQUIRED=false

# LLM_GLOBAL_CONCURRENCY=48
# LLM_PER_USER_CONCURRENCY=16
# LLM_CHAT_TIMEOUT_MS=90000
# LLM_CHAT_RETRIES=3
# JOB_SEARCH_RESUME_CONCURRENCY=8
# RESUME_GENERATE_JOB_TIMEOUT_MS=120000
# JOB_TITLE_REVIEW_BATCH_SIZE=10
# JOB_TITLE_REVIEW_CONCURRENCY=10
# JOB_AI_ANALYZE_BATCH_SIZE=6
# JOB_AI_ANALYZE_BATCH_CONCURRENCY=8
# JOB_AI_STALE_CLAIM_MS=900000
# JOB_AI_ANALYZE_JD_MAX_CHARS=8000
# RESUME_ANALYZE_BATCH_CONCURRENCY=12
# RECOMMEND_RESUME_CONCURRENCY=8
# RESUME_BULK_UPLOAD_CONCURRENCY=8

# DeepSeek (profile defaultProvider=deepseek): models deepseek-flash (V4.1-Flash) / deepseek-v4-pro.
# Chat requests send thinking.type=disabled for fast JSON batch work.

# Mail / IMAP (optional)
# IMAP_MAX_CONNS_PER_ACCOUNT=8
# BACKGROUND_WORKERS_MODE=embedded
# Production image splits API vs worker in Supervisord (off + worker).

# Job ingest / dedupe
# Rolling window (days) for applyLink or company+title duplicates. Floor is 14.
JOB_DEDUP_WINDOW_DAYS=14
# Written to TempJob/Job.model_schema_code on scrape ingest
JOB_MODEL_SCHEMA_CODE=mongodb-athens-2026-08-06

# Bid recordings (Athens Lens → Firebase Storage bid-recordings/)
# MAX_RECORDING_BYTES=8589934592
# Optional CORS fallback if the extension does not send chrome-extension://origin
# UPLOAD_CORS_ORIGIN=chrome-extension://your-extension-id
# ATHENS_LENS_SESSION_TTL_SECONDS=43200

# Oak (DOM relay + AI action plans) — Socket.io path /oak, HTTP under /api/oak
# OAK_SESSION_TTL_SECONDS=43200
# OAK_RUNTIME_FILE_PATH=/absolute/or/repo-relative/path/to/resume.docx
# OAK_RUNTIME_FILE_KEY=runtime_file
# OAK_OPENAI_REASONING_EFFORT=medium
# OAK_MAX_OUTPUT_TOKENS=12000
# OAK_PROSE_MAX_OUTPUT_TOKENS=6000
# OAK_PROSE_TIMEOUT_MS=20000
# OAK_EXTRACT_JD_MAX_OUTPUT_TOKENS=6000
# OAK_EXTRACT_JD_TIMEOUT_MS=25000
# OAK_IDENTITY_MAX_OUTPUT_TOKENS=2500
# OAK_IDENTITY_TIMEOUT_MS=8000
# OAK_PROSE_TEMPERATURE=0.4
# OAK_OPENAI_TEMPERATURE=0.1
# OAK_OPENAI_API_URL=https://api.openai.com/v1/responses

# Status / monitoring (Mongo durable + Prometheus live)
# MONITORING_ENABLED=false
# PROMETHEUS_URL=http://prometheus:9090
# PROMETHEUS_MAX_SCRAPE_AGE_SECONDS=120
# MONITOR_INTERVAL_MS=30000
# MONITOR_STALE_AFTER_MS=120000
# MONITOR_WARNING_SAMPLES=10
# MONITOR_CRITICAL_SAMPLES=4
# MONITOR_RECOVERY_SAMPLES=2
# METRICS_PORT=9101
# METRICS_HOST=0.0.0.0
# PUBLIC_PORT=9030
# PUBLIC_STATUS_CHECK_URL=
