# oak-backend: copy to .env and set ACORN_MONGO_URI.

PORT=8980
# Comma-separated browser origins. chrome-extension:// is always allowed.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Acorn's MongoDB (the one acorn-backend uses): accounts, sessions, profiles,
# the résumé Library, and AI usage.
ACORN_MONGO_URI=
ACORN_DB=AcornDB
# acorn-backend origin; sign-in and sign-out go through it.
ACORN_API_URL=http://127.0.0.1:8083

# Optional
# LOG_LEVEL=debug
# LOG_PRETTY=true
# OAK_OPENROUTER_MODEL=openai/gpt-6-luna
# OAK_OPENAI_MODEL=gpt-6-luna
# OAK_OPENAI_REASONING_EFFORT=medium
